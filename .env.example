YEAR=2024
MONTH=1
DATA_DIR=data
MODEL_DIR=models
MODEL_PATH=models/model.pkl
REPORT_PATH=reports/module-1.md
VALIDATION_FRACTION=0.20

# MLflow tracking server exposed by docker/docker-compose.yml
MLFLOW_TRACKING_URI=http://localhost:5000
EXPERIMENT_NAME=taxi-duration
REGISTERED_MODEL_NAME=taxi-duration
PRODUCTION_MODEL_URI=models:/taxi-duration/Production

# PostgreSQL and MLflow Compose settings
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=mlflow
POSTGRES_DB=mlflow
POSTGRES_PORT=5432
MLFLOW_PORT=5000
MLFLOW_VERSION=3.15.2
# MinIO settings
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minio_user
AWS_SECRET_ACCESS_KEY=minio_password